{
  "name": "loan-portfolio-mcp",
  "version": "1.0.0",
  "description": "Production-style MCP server exposing a synthetic loan portfolio to AI assistants, with JWT auth, RBAC, audit logging and tracing.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "bin": {
    "loan-portfolio-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --transport=http",
    "dev": "tsx src/index.ts",
    "seed": "tsx src/db/seed-cli.ts",
    "seed:demo": "tsx src/db/seed-cli.ts --as-of=2026-10-31",
    "seed:prod": "node dist/db/seed-cli.js",
    "token": "tsx scripts/dev-token.ts",
    "audit:tail": "tsx scripts/audit-tail.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@opentelemetry/api": "~1.9.0",
    "@opentelemetry/core": "^2.12.1",
    "@opentelemetry/resources": "^2.12.1",
    "@opentelemetry/sdk-trace-base": "^2.12.1",
    "@opentelemetry/sdk-trace-node": "^2.12.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "better-sqlite3": "^13.2.0",
    "express": "^5.3.0",
    "jose": "^6.2.17",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "better-sqlite3@13.2.0": false,
    "esbuild@0.28.2": true
  }
}
