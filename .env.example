# Copy to .env and adjust. Every variable is optional unless marked REQUIRED.
# The server validates all of these at startup and refuses to start on invalid values.

# ---- General --------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info                    # fatal|error|warn|info|debug|trace|silent (logs go to stderr)

# ---- Storage --------------------------------------------------------------------
# Defaults are <project>/data/portfolio.db and <project>/data/audit.db
# DB_PATH=./data/portfolio.db
# AUDIT_DB_PATH=./data/audit.db
# SEED_AS_OF=2026-10-31           # pin the synthetic data as-of date (default: end of last month)
# SEED=42                         # random seed for the synthetic data

# ---- Transport ------------------------------------------------------------------
MCP_TRANSPORT=stdio               # stdio (Claude Desktop) | http
HTTP_HOST=127.0.0.1
HTTP_PORT=3000
HTTP_MAX_BODY_BYTES=65536
# PUBLIC_URL=https://mcp.example.com/mcp   # enables /.well-known/oauth-protected-resource

# ---- stdio identity (local use) ------------------------------------------------
STDIO_SUBJECT=local-user
STDIO_ROLE=analyst                # analyst (names masked) | admin

# ---- HTTP auth: REQUIRED when MCP_TRANSPORT=http --------------------------------
# Exactly one of AUTH_JWKS_URL (production, asymmetric keys) or AUTH_JWT_SECRET (dev, HS256).
# AUTH_JWKS_URL=https://your-org.okta.com/oauth2/default/v1/keys
AUTH_JWT_SECRET=replace-with-a-random-string-of-at-least-32-chars
AUTH_ISSUER=https://local-dev
AUTH_AUDIENCE=loan-portfolio-mcp
AUTH_ROLE_CLAIM=roles             # Okta: groups   | Entra ID: roles  | Keycloak: realm_access.roles
AUTH_ADMIN_VALUES=admin           # comma-separated claim values that grant admin
AUTH_ANALYST_VALUES=analyst       # comma-separated claim values that grant analyst
AUTH_CLOCK_TOLERANCE_SEC=30
# AUTH_AUTHORIZATION_SERVER=https://your-org.okta.com/oauth2/default

# ---- Guardrails -----------------------------------------------------------------
TOOL_TIMEOUT_MS=5000
MAX_TOOL_INPUT_BYTES=4096
AUDIT_ENABLED=true

# ---- Observability --------------------------------------------------------------
OTEL_TRACES_EXPORTER=console      # console (stderr) | none
OTEL_SERVICE_NAME=loan-portfolio-mcp
